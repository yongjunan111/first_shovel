# 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/earthcanvas

# JWT 설정
JWT_SECRET_KEY=your-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OAuth — Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# OAuth — Kakao
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback

# 환경
ENV=development

# 로컬 개발 로그인 허용 — 로컬 개발 전용. 운영 배포 전 제거 또는 false 필수.
# 기본값은 False (config.py). 로컬에서만 필요할 때 true로 명시해서 켠다.
ALLOW_DEV_LOGIN=false
